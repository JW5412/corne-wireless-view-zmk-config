#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

&mt {
    flavor = "balanced";
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        Down: Down {
            compatible = "zmk,behavior-mod-morph";
            label = "DOWN";
            bindings = <&mt RCTRL J>, <&kp DOWN_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        Up: Up {
            compatible = "zmk,behavior-mod-morph";
            label = "UP";
            bindings = <&mt RIGHT_SHIFT K>, <&kp UP_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        Left: Left {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFT";
            bindings = <&kp H>, <&kp LEFT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        Right: Right {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHT";
            bindings = <&mt RIGHT_ALT L>, <&kp RIGHT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        PgUp: PgUp {
            compatible = "zmk,behavior-mod-morph";
            label = "PGUP";
            bindings = <&kp Y>, <&kp PAGE_UP>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        PgDn: PgDn {
            compatible = "zmk,behavior-mod-morph";
            label = "PGDN";
            bindings = <&kp N>, <&kp PAGE_DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        StickyLayer: StickyLayer {
            compatible = "zmk,behavior-tap-dance";
            label = "STICKYLAYER";
            #binding-cells = <0>;
            bindings = <&tog 3>, <&tog 4>;
        };

        SemiColon: SemiColon {
            compatible = "zmk,behavior-mod-morph";
            label = "SEMICOLON";
            bindings = <&mt RIGHT_META SEMI>, <&kp ESCAPE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp ESCAPE   &kp Q           &kp W           &kp E             &kp R        &kp T        &PgUp    &kp U            &kp I         &kp O    &kp P       &kp BSPC
&lt 1 TAB    &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt RCTRL F  &lt 4 G      &Left    &Down            &Up           &Right   &SemiColon  &lt 2 SINGLE_QUOTE
&lt 1 TILDE  &kp Z           &kp X           &kp C             &kp V        &kp B        &PgDn    &kp M            &kp COMMA     &kp DOT  &kp FSLH    &lt 2 PIPE
                                             &kp LGUI          &kp LCTRL    &kp SPACE    &kp RET  &kp RIGHT_SHIFT  &StickyLayer
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&trans  &kp N1             &kp N2      &kp N3            &kp N4  &kp N5    &kp N6  &kp N7  &kp N8         &kp N9            &kp N0        &trans
&trans  &kp K_VOLUME_UP    &trans      &trans            &trans  &trans    &trans  &trans  &trans         &trans            &kp COLON     &kp DOUBLE_QUOTES
&trans  &kp K_VOLUME_DOWN  &kp C_NEXT  &kp C_PLAY_PAUSE  &trans  &trans    &trans  &trans  &kp LESS_THAN  &kp GREATER_THAN  &kp QUESTION  &kp BACKSLASH
                                       &trans            &trans  &trans    &trans  &trans  &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&trans     &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS         &kp KP_MULTIPLY  &kp LPAR          &kp RPAR           &trans
&trans     &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp PLUS         &kp KP_EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&kp GRAVE  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp EXCLAMATION  &kp AMPS         &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans
                             &trans    &trans    &trans       &trans     &trans           &trans
            >;
        };

        nav_layer {
            bindings = <
&to 0   &trans  &trans  &trans  &trans  &trans    &kp PAGE_UP     &trans          &kp I         &kp O            &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp ESCAPE  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp PAGE_DOWN   &kp LS(M)       &trans        &trans           &trans      &trans
                        &trans  &trans  &trans    &trans          &trans          &to 0
            >;

            label = "Navigation";
        };

        mouse_layer {
            bindings = <
&to 0   &trans  &trans  &trans  &trans  &trans    &msc SCRL_UP    &mkp LCLK       &mkp MCLK     &mkp RCLK        &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &kp ESCAPE  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &msc SCRL_DOWN  &trans          &trans        &trans           &trans      &trans
                        &trans  &trans  &trans    &trans          &trans          &to 0
            >;

            label = "Mouse";
        };
    };
};
