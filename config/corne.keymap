#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

&mt {
    tapping-term-ms = <280>;
    flavor = "balanced";
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp ESCAPE   &kp Q           &kp W           &kp E             &kp R        &kp T        &kp Y    &kp U            &kp I      &kp O    &kp P          &kp BSPC
&lt 1 TAB    &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LCTRL F  &lt 4 G      &kp H    &kp J            &kp K      &kp L    &kp SEMICOLON  &lt 2 SINGLE_QUOTE
&lt 1 TILDE  &kp Z           &kp X           &kp C             &kp V        &kp B        &kp N    &kp M            &kp COMMA  &kp DOT  &kp FSLH       &lt 2 PIPE
                                             &kp LGUI          &kp LCTRL    &kp SPACE    &kp RET  &kp RIGHT_SHIFT  &tog 3
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&trans  &kp N1             &kp N2      &kp N3            &kp N4          &kp N5    &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &trans
&trans  &kp K_VOLUME_UP    &trans      &trans            &trans          &trans    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &kp K_VOLUME_DOWN  &kp C_NEXT  &kp C_PLAY_PAUSE  &kp C_PREVIOUS  &trans    &trans    &trans    &trans  &trans     &trans  &trans
                                       &trans            &trans          &trans    &trans    &trans    &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS         &kp KP_MULTIPLY  &kp LPAR          &kp RPAR           &trans
&trans  &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp PLUS         &kp KP_EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp EXCLAMATION  &kp AMPS         &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans
                          &trans    &trans    &trans       &trans     &trans           &tog 3
            >;
        };

        nav_layer {
            bindings = <
&to 0   &trans  &trans  &trans  &trans  &trans    &kp PAGE_UP     &trans          &kp I         &kp O            &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp PAGE_DOWN   &kp LS(M)       &trans        &trans           &trans  &trans
                        &trans  &trans  &trans    &trans          &trans          &to 0
            >;

            label = "Navigation";
        };

        mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &msc SCRL_UP    &mkp LCLK       &mkp RCLK     &mkp MCLK        &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &kp ESCAPE  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &msc SCRL_DOWN  &trans          &trans        &trans           &trans      &trans
                        &trans  &trans  &trans    &trans          &trans          &trans
            >;

            label = "Mouse";
        };
    };
};

